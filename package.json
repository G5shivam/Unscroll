{
  "name": "unscroll",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "gen:inject": "node scripts/gen-inject.mjs",
    "test": "TZ=Asia/Kolkata jest",
    "test:utc": "TZ=UTC jest",
    "test:kotlin": "bash native-tests/run-kotlin-tests.sh",
    "build:web:e2e": "EXPO_PUBLIC_E2E=1 expo export --platform web --output-dir dist-e2e",
    "build:web": "expo export --platform web --output-dir dist",
    "test:browser": "node e2e/run-all.mjs",
    "test:all": "npm run typecheck && node scripts/gen-inject.mjs --check && npm test && npm run test:utc -- --silent && npm run test:browser",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist",
      "/native-tests/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-webview)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.generated.ts",
      "!src/app/**"
    ]
  }
}
